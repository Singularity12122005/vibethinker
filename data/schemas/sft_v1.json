{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sft_v1.json",
  "title": "VibeThinker SFT record",
  "type": "object",
  "required": ["messages"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "_domain": {"enum": ["math", "code", "stem", "general"]},
    "_source": {"type": "string"},
    "_prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
