{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vibethinker/panel-row.schema.json",
  "title": "Panel row",
  "type": "object",
  "additionalProperties": false,
  "required": ["panel_id", "domain", "messages", "grading"],
  "properties": {
    "panel_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["math", "code", "stem", "ifc", "knowledge"]},
    "fixture": {"const": "synthetic-toy"},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "grading": {"type": "object"}
  }
}
