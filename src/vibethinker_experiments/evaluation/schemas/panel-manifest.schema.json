{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vibethinker/panel-manifest.schema.json",
  "title": "Panel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "panel_name",
    "panel_version",
    "mode",
    "panel_sha256",
    "row_count",
    "domains"
  ],
  "properties": {
    "panel_name": {"type": "string", "minLength": 1},
    "panel_version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["toy", "formal"]},
    "panel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_count": {"type": "integer", "minimum": 1},
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["math", "code", "stem", "ifc", "knowledge"]}
    }
  }
}
