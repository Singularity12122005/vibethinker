{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vibethinker/generation-result.schema.json",
  "title": "Immutable generation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "panel_id",
    "domain",
    "raw_completion",
    "prompt_tokens",
    "completion_tokens",
    "finish_reason",
    "profile_id",
    "panel_sha256",
    "generation_sha256"
  ],
  "properties": {
    "panel_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["math", "code", "stem", "ifc", "knowledge"]},
    "raw_completion": {"type": "string"},
    "prompt_tokens": {"type": "integer", "minimum": 0},
    "completion_tokens": {"type": "integer", "minimum": 0},
    "finish_reason": {"type": "string"},
    "profile_id": {"type": "string", "minLength": 1},
    "panel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
